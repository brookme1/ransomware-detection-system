# Backend environment template for Ransomware Detection System
# Copy this file to `.env` and adjust values before running locally or on Render.

# -------------------- Server Settings --------------------
DEBUG=False
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-me-in-production

# -------------------- Database ---------------------------
# Options: sqlite | mysql | mongodb
DB_TYPE=sqlite
# SQLITE_PATH=database/ransomware.db

# MySQL (only used when DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=render
MYSQL_PASSWORD=super-secret
MYSQL_DATABASE=ransomware_db

# MongoDB (only used when DB_TYPE=mongodb)
# MONGODB_URI=mongodb://localhost:27017/
# MONGODB_DATABASE=ransomware_db

# -------------------- Alerts -----------------------------
WEBHOOK_ENABLED=False
WEBHOOK_URL=

SMTP_ENABLED=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TO=

# -------------------- File & ML Settings -----------------
MAX_FILE_SIZE=104857600
MODEL_PATH=models/ransomware_detector.pkl
MALICIOUS_THRESHOLD=0.5
